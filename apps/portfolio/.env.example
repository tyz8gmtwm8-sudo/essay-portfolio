# ===== ポートフォリオサイト（apps/portfolio）の環境変数 =====
# このファイルをコピーして .env.local を作り、値を入れてください。
#   cp .env.example .env.local
#
# ※ このアプリは閲覧専用です。firebase-admin や Cloudinary の秘密鍵は絶対に入れないでください。

# --- Firebase（公開してよい設定値。編集サイトと同じ値）---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# このサイト自身のURL（OGP画像などの絶対URLに使う）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 編集サイトのURL（トップページの「はじめる」ボタンのリンク先）
NEXT_PUBLIC_EDITOR_URL=http://localhost:3001
