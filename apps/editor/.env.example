# ===== 編集サイト（apps/editor）の環境変数 =====
# このファイルをコピーして .env.local を作り、値を入れてください。
#   cp .env.example .env.local
# .env.local は .gitignore 済みなので GitHub には公開されません。

# --- Firebase（公開してよい設定値。Firebaseコンソール > プロジェクトの設定 > マイアプリ）---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# true にすると本物の Firebase ではなく、パソコン上の Firebase Emulator に接続します
# （Emulator を使うときは PROJECT_ID を demo-portfolio にしてください）
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# --- ポートフォリオサイトのURL（ダッシュボードに表示する自分のURLの先頭部分）---
NEXT_PUBLIC_PORTFOLIO_URL=http://localhost:3000

# --- Cloudinary（画像保存サービス。ダッシュボードの API Keys 画面）---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# ↓ 秘密情報。サーバー側（app/api）だけで使います
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- firebase-admin（秘密情報。Firebaseコンソール > プロジェクトの設定 > サービスアカウント > 新しい秘密鍵の生成）---
# ダウンロードした JSON の project_id / client_email / private_key をそれぞれ入れます
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# 改行は \n のまま、全体をダブルクォートで囲んでください
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
